<ShaderNodePreset SupportsAdaptiveDegradation="False" SupportsAction="False" SupportsTransition="False" SupportsTimeline="False" TimelineUseBack="False" MatteProvider="True" CommercialUsePermitted="True" ShaderType="Matchbox" SoftwareVersion="2016.0.0" LimitInputsToTexture="True" Version="1" Description="Block style drop shadow. Extrudes the matte along an angle to create a solid shadow, optionally softens it with a gaussian blur, then comps the fill (colour or Front) over it. The shadow can be coloured with a flat colour or the optional Shadow Fill input. Outputs premultiplied RGB and the combined fill + shadow matte." Name="BlockShadow">
   <!-- Pass 1: premultiplied fill in RGB, matte in A -->
   <Shader OutputBitDepth="Output" Index="1">
      <Uniform Index="0" NoInput="Black" Tooltip="Front (RGB). Used as the fill when Use Front as Fill is on." DisplayName="Front" InputType="Front" Mipmaps="False" GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE" GL_TEXTURE_MAG_FILTER="GL_LINEAR" GL_TEXTURE_MIN_FILTER="GL_LINEAR" Type="sampler2D" Name="front">
