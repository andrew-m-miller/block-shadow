      <Uniform Row="1" Col="2" Page="0" Default="" Tooltip="Shadow colour (ignored when Use Shadow Fill Input is on)." Type="vec3" ValueType="Colour" DisplayName="Shadow Colour" Name="shadowColor">
         <SubUniform ResDependent="None" Max="1000000.0" Min="-1000000.0" Default="0.0" Inc="0.01">
