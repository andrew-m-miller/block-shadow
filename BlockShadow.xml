         <SubUniform ResDependent="None" Max="1000000.0" Min="-1000000.0" Default="1.0" Inc="0.01">
         </SubUniform>
         <SubUniform ResDependent="None" Max="1000000.0" Min="-1000000.0" Default="1.0" Inc="0.01">
         </SubUniform>
         <SubUniform ResDependent="None" Max="1000000.0" Min="-1000000.0" Default="1.0" Inc="0.01">
         </SubUniform>
      </Uniform>
   </Shader>

   <!-- Pass 2: extrude the matte into a hard block shadow -->
   <Shader OutputBitDepth="Output" Index="2">
      <Uniform Mipmaps="False" GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE" GL_TEXTURE_MAG_FILTER="GL_LINEAR" GL_TEXTURE_MIN_FILTER="GL_LINEAR" Type="sampler2D" Name="adsk_results_pass1">
      </Uniform>
      <Uniform ResDependent="None" Max="360.0" Min="-360.0" Default="-45.0" Inc="1.0" Tooltip="Shadow direction in degrees. 0 = right, 90 = up, -45 = down-right." Row="0" Col="0" Page="0" Type="float" DisplayName="Angle" Name="angle">
      </Uniform>
      <Uniform ResDependent="None" Max="4000.0" Min="0.0" Default="20.0" Inc="1.0" Tooltip="Shadow extrusion length in pixels." Row="1" Col="0" Page="0" Type="float" DisplayName="Length" Name="shadowLength">
      </Uniform>
   </Shader>

   <!-- Pass 3: horizontal gaussian blur of the shadow -->
   <Shader OutputBitDepth="Output" Index="3">
      <Uniform Mipmaps="False" GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE" GL_TEXTURE_MAG_FILTER="GL_NEAREST" GL_TEXTURE_MIN_FILTER="GL_NEAREST" Type="sampler2D" Name="adsk_results_pass2">
      </Uniform>
      <Uniform ResDependent="None" Max="340.0" Min="0.0" Default="0.0" Inc="0.1" Tooltip="Gaussian blur of the shadow, in pixels (sigma). 0 = hard edges." Row="2" Col="0" Page="0" Type="float" DisplayName="Softness" Name="softness">
      </Uniform>
   </Shader>

   <!-- Pass 4: vertical gaussian blur, then comp fill over shadow -->
   <Shader OutputBitDepth="Output" Index="4">
      <Uniform Mipmaps="False" GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE" GL_TEXTURE_MAG_FILTER="GL_NEAREST" GL_TEXTURE_MIN_FILTER="GL_NEAREST" Type="sampler2D" Name="adsk_results_pass1">
      </Uniform>
      <Uniform Mipmaps="False" GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE" GL_TEXTURE_MAG_FILTER="GL_NEAREST" GL_TEXTURE_MIN_FILTER="GL_NEAREST" Type="sampler2D" Name="adsk_results_pass3">
      </Uniform>
      <Uniform Index="2" NoInput="White" Tooltip="Shadow Fill (RGB), optional. A gradient or texture used to colour the shadow when Use Shadow Fill Input is on." DisplayName="Shadow Fill" InputType="Back" Mipmaps="False" GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE" GL_TEXTURE_MAG_FILTER="GL_LINEAR" GL_TEXTURE_MIN_FILTER="GL_LINEAR" Type="sampler2D" Name="shadowFill">
